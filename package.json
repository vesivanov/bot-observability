{
  "name": "bot-observability",
  "version": "0.1.0",
  "description": "Open-source, self-hosted analytics for AI crawlers, search engines, SEO tools, and automated agents across websites.",
  "keywords": [
    "bot-detection",
    "bot-analytics",
    "crawl-analytics",
    "crawl-monitoring",
    "crawler",
    "analytics",
    "ai-crawlers",
    "ai-search",
    "seo-monitoring",
    "geo",
    "search-engine-optimization",
    "observability",
    "self-hosted",
    "nextjs",
    "postgres"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vesivanov/bot-observability.git"
  },
  "bugs": {
    "url": "https://github.com/vesivanov/bot-observability/issues"
  },
  "homepage": "https://github.com/vesivanov/bot-observability",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "migrate": "node scripts/migrate.mjs",
    "reconcile-rollups": "node scripts/reconcile-rollups.mjs",
