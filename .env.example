# Required
DATABASE_URL=postgres://user:pass@host:port/dbname?sslmode=require

# New role-specific secrets (32+ random characters each)
BOT_ADMIN_TOKEN=replace-with-at-least-32-random-characters
BOT_IP_HASH_SECRET=replace-with-a-different-32-character-secret
BOT_INGEST_TOKENS='{"marketing-site":"replace-with-a-project-ingest-secret"}'
BOT_ACCEPT_LEGACY_INGEST=false

# Migration fallback only. Remove after all senders use BOT_INGEST_TOKENS.
# BOT_LOG_TOKEN=replace-with-at-least-32-random-characters

# Reachable collector origin used by the connection instructions (never request headers).
BOT_COLLECTOR_ORIGIN=http://localhost:3000
# Per-project, per-process bot submissions/minute. Non-bots do not consume it.
BOT_EVENT_RPM=120
# Query values are discarded unless explicitly allowed by key.
BOT_QUERY_ALLOWLIST=
# For Compose only: DATABASE_URL can use postgres://postgres:postgres@db:5432/bot_observability
# POSTGRES_PASSWORD=postgres
# BOT_PORT=3000
# BOT_LISTEN_ADDRESS=127.0.0.1
